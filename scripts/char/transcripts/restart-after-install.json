{
	"name": "restart-after-install",
	"description": "Pi missing at start, then 'installed' while the app runs (the switch is unset), then restart: restartChat calls refreshPi, finds the stand-in without an app restart, spawns it with the usual arguments, and a turn runs.",
	"synthetic": "Built from the record shapes the app consumes (src/renderer.js handleRecord, src/sessions.js), not from a real Pi session.",
	"state": {
		"model": {
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		},
		"thinkingLevel": "off",
		"isStreaming": false,
		"sessionFile": "/char/session.jsonl",
		"messageCount": 0
	},
	"models": [
		{
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		}
	],
	"rules": [
		{
			"on": {
				"type": "prompt"
			},
			"emit": [
				{
					"type": "agent_start"
				},
				{
					"type": "message_start",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Say hi"
							}
						]
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Say hi"
							}
						]
					}
				},
				{
					"type": "message_start",
					"message": {
						"role": "assistant",
						"content": [],
						"stopReason": "stop"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "thinking_delta",
						"contentIndex": 0,
						"delta": "Greeting."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "thinking_end",
						"contentIndex": 0,
						"content": "Greeting."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 1,
						"delta": "Hello"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 1,
						"delta": " there."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_end",
						"contentIndex": 1,
						"content": "Hello there."
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "assistant",
						"content": [
							{
								"type": "thinking",
								"thinking": "Greeting."
							},
							{
								"type": "text",
								"text": "Hello there."
							}
						],
						"stopReason": "stop"
					}
				},
				{
					"type": "agent_end",
					"messages": []
				},
				{
					"type": "agent_settled"
				}
			]
		}
	],
	"env": {
		"PI_CRUST_SELFTEST_NO_PI": "1"
	},
	"waitFor": "pi:exit",
	"drive": [
		{
			"do": "settle",
			"ms": 500
		},
		{
			"do": "unsetEnv",
			"name": "PI_CRUST_SELFTEST_NO_PI"
		},
		{
			"do": "restart"
		},
		{
			"do": "waitEmit",
			"match": {
				"channel": "pi:ready"
			}
		},
		{
			"do": "settle",
			"ms": 800
		},
		{
			"do": "send",
			"record": {
				"id": "drv-1",
				"type": "prompt",
				"message": "Say hi"
			}
		},
		{
			"do": "waitEmit",
			"match": {
				"channel": "pi:record",
				"payload.record.type": "agent_settled"
			}
		}
	]
}
