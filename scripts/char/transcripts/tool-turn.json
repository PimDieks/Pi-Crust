{
	"name": "tool-turn",
	"description": "A turn with a tool call and its result, then a failing tool call.",
	"synthetic": "Built from the record shapes the app consumes (src/renderer.js handleRecord, src/sessions.js), not from a real Pi session.",
	"state": {
		"model": {
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		},
		"thinkingLevel": "off",
		"isStreaming": false,
		"sessionFile": "/char/session.jsonl",
		"messageCount": 0
	},
	"models": [
		{
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		}
	],
	"rules": [
		{
			"on": {
				"type": "prompt"
			},
			"emit": [
				{
					"type": "agent_start"
				},
				{
					"type": "message_start",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Read the file"
							}
						]
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Read the file"
							}
						]
					}
				},
				{
					"type": "message_start",
					"message": {
						"role": "assistant",
						"content": [],
						"stopReason": "stop"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "toolcall_start",
						"contentIndex": 0,
						"id": "tc-1",
						"toolName": "read"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "toolcall_end",
						"contentIndex": 0,
						"toolCall": {
							"type": "toolCall",
							"id": "tc-1",
							"name": "read",
							"arguments": {
								"path": "README.md"
							}
						}
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "assistant",
						"content": [
							{
								"type": "toolCall",
								"id": "tc-1",
								"name": "read",
								"arguments": {
									"path": "README.md"
								}
							}
						],
						"stopReason": "toolUse"
					}
				},
				{
					"type": "tool_execution_start",
					"toolCallId": "tc-1",
					"toolName": "read",
					"args": {
						"path": "README.md"
					}
				},
				{
					"type": "tool_execution_update",
					"toolCallId": "tc-1",
					"toolName": "read",
					"args": {
						"path": "README.md"
					},
					"partialResult": {
						"content": [
							{
								"type": "text",
								"text": "# Char"
							}
						]
					}
				},
				{
					"type": "tool_execution_end",
					"toolCallId": "tc-1",
					"toolName": "read",
					"args": {
						"path": "README.md"
					},
					"result": {
						"content": [
							{
								"type": "text",
								"text": "# Char\nfixture"
							}
						]
					},
					"isError": false,
					"durationMs": 12
				},
				{
					"type": "message_start",
					"message": {
						"role": "assistant",
						"content": [],
						"stopReason": "stop"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "toolcall_start",
						"contentIndex": 0,
						"id": "tc-2",
						"toolName": "bash"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "toolcall_end",
						"contentIndex": 0,
						"toolCall": {
							"type": "toolCall",
							"id": "tc-2",
							"name": "bash",
							"arguments": {
								"command": "exit 1"
							}
						}
					}
				},
				{
					"type": "tool_execution_start",
					"toolCallId": "tc-2",
					"toolName": "bash",
					"args": {
						"command": "exit 1"
					}
				},
				{
					"type": "tool_execution_end",
					"toolCallId": "tc-2",
					"toolName": "bash",
					"args": {
						"command": "exit 1"
					},
					"result": {
						"content": [
							{
								"type": "text",
								"text": "exit code 1"
							}
						]
					},
					"isError": true,
					"durationMs": 30
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 0,
						"delta": "Done."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_end",
						"contentIndex": 0,
						"content": "Done."
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "assistant",
						"content": [
							{
								"type": "text",
								"text": "Done."
							}
						],
						"stopReason": "stop"
					}
				},
				{
					"type": "agent_end",
					"messages": []
				},
				{
					"type": "agent_settled"
				}
			]
		}
	],
	"drive": [
		{
			"do": "send",
			"record": {
				"id": "drv-1",
				"type": "prompt",
				"message": "Read the file"
			}
		},
		{
			"do": "waitEmit",
			"match": {
				"channel": "pi:record",
				"payload.record.type": "agent_settled"
			}
		}
	]
}
