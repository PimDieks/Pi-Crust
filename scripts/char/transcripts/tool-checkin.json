{
	"name": "tool-checkin",
	"description": "The tool-call check-in setting (settings.json toolCallCheckIn = 7) reaches the agent as env PI_CRUST_TOOL_CHECKIN=7 (the default scenarios show 40).",
	"synthetic": "Built from the record shapes the app consumes (src/renderer.js handleRecord, src/sessions.js), not from a real Pi session.",
	"state": {
		"model": {
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		},
		"thinkingLevel": "off",
		"isStreaming": false,
		"sessionFile": "/char/session.jsonl",
		"messageCount": 0
	},
	"models": [
		{
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		}
	],
	"settings": {
		"toolCallCheckIn": 7
	},
	"rules": [
		{
			"on": {
				"type": "prompt"
			},
			"emit": [
				{
					"type": "agent_start"
				},
				{
					"type": "message_start",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Say hi"
							}
						]
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Say hi"
							}
						]
					}
				},
				{
					"type": "message_start",
					"message": {
						"role": "assistant",
						"content": [],
						"stopReason": "stop"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "thinking_delta",
						"contentIndex": 0,
						"delta": "Greeting."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "thinking_end",
						"contentIndex": 0,
						"content": "Greeting."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 1,
						"delta": "Hello"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 1,
						"delta": " there."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_end",
						"contentIndex": 1,
						"content": "Hello there."
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "assistant",
						"content": [
							{
								"type": "thinking",
								"thinking": "Greeting."
							},
							{
								"type": "text",
								"text": "Hello there."
							}
						],
						"stopReason": "stop"
					}
				},
				{
					"type": "agent_end",
					"messages": []
				},
				{
					"type": "agent_settled"
				}
			]
		}
	],
	"drive": [
		{
			"do": "settle",
			"ms": 300
		}
	]
}
