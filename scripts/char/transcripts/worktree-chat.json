{
	"name": "worktree-chat",
	"description": "A second chat in its own git worktree: pi:started carries the worktree, the agent runs in that folder, requests reach it, and closing it waits for the process, then kills what is left of its tree.",
	"synthetic": "Built from the record shapes the app consumes (src/renderer.js handleRecord, src/sessions.js), not from a real Pi session.",
	"state": {
		"model": {
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		},
		"thinkingLevel": "off",
		"isStreaming": false,
		"sessionFile": "/char/session.jsonl",
		"messageCount": 0
	},
	"models": [
		{
			"provider": "char",
			"id": "char-1",
			"name": "Char One"
		}
	],
	"rules": [
		{
			"on": {
				"type": "prompt"
			},
			"emit": [
				{
					"type": "agent_start"
				},
				{
					"type": "message_start",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Say hi"
							}
						]
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "user",
						"content": [
							{
								"type": "text",
								"text": "Say hi"
							}
						]
					}
				},
				{
					"type": "message_start",
					"message": {
						"role": "assistant",
						"content": [],
						"stopReason": "stop"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "thinking_delta",
						"contentIndex": 0,
						"delta": "Greeting."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "thinking_end",
						"contentIndex": 0,
						"content": "Greeting."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 1,
						"delta": "Hello"
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_delta",
						"contentIndex": 1,
						"delta": " there."
					}
				},
				{
					"type": "message_update",
					"assistantMessageEvent": {
						"type": "text_end",
						"contentIndex": 1,
						"content": "Hello there."
					}
				},
				{
					"type": "message_end",
					"message": {
						"role": "assistant",
						"content": [
							{
								"type": "thinking",
								"thinking": "Greeting."
							},
							{
								"type": "text",
								"text": "Hello there."
							}
						],
						"stopReason": "stop"
					}
				},
				{
					"type": "agent_end",
					"messages": []
				},
				{
					"type": "agent_settled"
				}
			]
		}
	],
	"drive": [
		{
			"do": "settle",
			"ms": 300
		},
		{
			"do": "git",
			"args": [
				"worktree",
				"add",
				"<TMP>/wt",
				"-b",
				"char-wt"
			]
		},
		{
			"do": "ipc",
			"channel": "pi:newChat",
			"args": [
				null,
				{
					"cwd": "<TMP>/wt"
				}
			]
		},
		{
			"do": "waitEmit",
			"match": {
				"channel": "pi:ready",
				"payload.chatId": "chat-2"
			}
		},
		{
			"do": "settle",
			"ms": 600
		},
		{
			"do": "request",
			"chat": "chat-2",
			"type": "get_state"
		},
		{
			"do": "closeAndWait",
			"chat": "chat-2"
		},
		{
			"do": "settle",
			"ms": 300
		}
	]
}
