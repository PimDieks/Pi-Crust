<?xml version="1.0" encoding="UTF-8"?>
<!-- Pi Crust fills the virtual screen, without a title bar. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
